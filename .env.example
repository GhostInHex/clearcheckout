# Copy to .env. server/index.js loads it at startup on Node 22+.
# Server only. Never use a VITE_ prefix or commit the real key.
MODEL_API_KEY=
# Alternatively read a private UTF-8 key file outside the repository.
# MODEL_API_KEY_FILE=/private/path/meta-key
# Model is fixed to muse-spark-1.3-contributor.
META_AI_BUDGET_USD=5
META_AI_CALL_LIMIT=100
PORT=3000
# DB_PATH=data/clearcheckout.sqlite
# Set true only behind HTTPS. Local HTTP needs false.
COOKIE_SECURE=false
