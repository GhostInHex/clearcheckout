# Copy to .env. Next loads it at startup on Node 22+.
# Server only. Never use a VITE_ prefix or commit the real key.
MODEL_API_KEY=
# Alternatively read a private UTF-8 key file outside the repository.
# MODEL_API_KEY_FILE=/private/path/meta-key
# Model is fixed to muse-spark-1.3-contributor.
META_AI_BUDGET_USD=5
META_AI_CALL_LIMIT=100
PORT=3000
# DB_PATH=data/clearcheckout.sqlite
# Set true only behind HTTPS. Local HTTP needs false.
COOKIE_SECURE=false
# Set to the exact public HTTPS origin when a proxy rewrites Host.
PUBLIC_ORIGIN=
# Use only when the reverse proxy connects from loopback.
TRUST_PROXY=
# Optional comma-separated additional exact public frontend origins. Never use wildcards.
PUBLIC_ORIGINS=

# Disabled until root securely supplies sandbox-only credentials and approves testing.
PAYPAL_SANDBOX_ENABLED=false
PAYPAL_MODE=sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_MERCHANT_ID=
PAYPAL_SANDBOX_WEBHOOK_ID=
