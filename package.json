{
  "name": "clearcheckout",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/next-start.ts --dev",
    "build": "tsx scripts/build-extension.ts && tsx scripts/prepare-next-assets.ts && next build --webpack",
    "start": "tsx scripts/next-start.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx tests/browser.ts",
    "test:dom": "tsx tests/dom-browser.ts",
    "test:extension": "tsx tests/extension-browser.ts",
    "test:meta-browser": "tsx tests/meta-browser.ts",
    "test:meta-live": "tsx tests/meta-live-browser.ts",
    "test:media-browser": "tsx tests/media-browser.ts",
    "test:media-live": "tsx scripts/verify-media-live.ts",
    "test:microphone": "tsx tests/microphone-browser.ts",
    "test:media-live-browser": "tsx tests/media-live-browser.ts",
    "build:vercel": "npm run build",
    "typecheck:checkout": "tsc -p tsconfig.checkout.json && tsc -p tsconfig.browser-tests.json",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.node-tests.json",
    "typecheck:frontend": "tsc -p tsconfig.frontend.json",
    "typecheck:extension": "tsc -p tsconfig.extension.json",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:extension && npm run typecheck:server && npm run typecheck:checkout && tsx scripts/verify-sources.ts && npm run typecheck:next",
    "lint": "tsx scripts/lint.ts",
    "test:regression": "tsx scripts/verify-regression.ts",
    "build:legacy": "vite build && tsx scripts/build-extension.ts && npm run build:server",
    "typecheck:next": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/chrome": "^0.3.7",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.25.12",
    "eslint": "^10.14.0",
    "jiti": "^2.7.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.2.2"
  },
  "engines": {
    "node": "22.x"
  }
}
