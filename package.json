{
  "name": "clearcheckout",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.js",
    "build": "vite build && tsx scripts/build-extension.ts",
    "start": "NODE_ENV=production tsx server/index.js",
    "test": "tsx --test tests/*.test.js tests/*.test.ts",
    "test:browser": "tsx tests/browser.js",
    "test:dom": "tsx tests/dom-browser.js",
    "test:extension": "tsx tests/extension-browser.js",
    "test:meta-browser": "tsx tests/meta-browser.js",
    "test:meta-live": "tsx tests/meta-live-browser.js",
    "test:media-browser": "tsx tests/media-browser.js",
    "test:media-live": "tsx scripts/verify-media-live.js",
    "test:microphone": "tsx tests/microphone-browser.js",
    "test:media-live-browser": "tsx tests/media-live-browser.js",
    "build:vercel": "npm run build && tsx scripts/copy-vercel-downloads.ts",
    "typecheck:checkout": "tsc -p tsconfig.checkout.json"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/chrome": "^0.3.7",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.2.2"
  },
  "engines": {
    "node": "22.x"
  }
}
